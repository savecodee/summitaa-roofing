# Summitaa Roofing — Whop integration
#
# Local development: copy this file to `.dev.vars` (the Cloudflare Vite plugin
# reads it) and fill in test values. Production: set each value as a Whop app
# secret or Cloudflare secret. Never commit real keys, tokens, or webhook
# secrets.

# Required for Leads, Events, Payments, Invoices, and payment-status lookups.
WHOP_API_KEY=

# Required for /api/whop/webhook signature verification.
WHOP_WEBHOOK_SECRET=

# Deposit checkout. Use a PAID plan_... identifier whose price matches the
# amount below exactly. The server refuses to report success on a mismatch.
WHOP_DEPOSIT_PLAN_ID=
WHOP_DEPOSIT_AMOUNT_CENTS=
WHOP_DEPOSIT_CURRENCY=usd

# Operator-only final invoice route. Leave the route disabled unless needed.
WHOP_OPERATOR_TOKEN=
WHOP_ENABLE_FINAL_INVOICE=false

# Optional: forward verified payment webhooks to an operator-controlled URL.
WHOP_FULFILLMENT_WEBHOOK_URL=
WHOP_FULFILLMENT_WEBHOOK_SECRET=

# Optional: only the official sandbox base is accepted.
# WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
